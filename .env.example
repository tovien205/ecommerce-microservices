# API Gateway
GATEWAY_PORT=3000

# Internal services
AUTH_PORT=3001
CUSTOMER_PORT=3002
PRODUCT_PORT=3003
ORDER_PORT=3004
SHIPMENT_PORT=3005

# PostgreSQL
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
AUTH_DATABASE_URL=postgresql://app_user:change_me@postgres:5432/auth_db
CUSTOMER_DATABASE_URL=postgresql://app_user:change_me@postgres:5432/customer_db
ORDER_DATABASE_URL=postgresql://app_user:change_me@postgres:5432/order_db

# MongoDB
MONGO_ROOT_USERNAME=app_user
MONGO_ROOT_PASSWORD=change_me
PRODUCT_MONGO_URI=mongodb://app_user:change_me@mongodb:27017/product_db?authSource=admin
SHIPMENT_MONGO_URI=mongodb://app_user:change_me@mongodb:27017/shipment_db?authSource=admin

# Redis
REDIS_URL=redis://redis:6379

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_ORDER_TOPIC=order-created

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d